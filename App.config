<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <connectionStrings>
        <add name="ResearchProject.My.MySettings.amsDBConnectionString"
            connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=amsDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
            providerName="Microsoft.Data.SqlClient" />
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
</configuration>